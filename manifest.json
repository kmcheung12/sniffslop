{
  "manifest_version": 3,
  "name": "SniffSlop",
  "version": "0.1.0",
  "description": "Hover any block of text to score how likely it is AI slop, via the TypeSafe System One API.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "action": {
    "default_title": "SniffSlop settings",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-sniff": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle sniff mode on this page"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sniffslop@local",
      "strict_min_version": "115.0"
    }
  }
}
